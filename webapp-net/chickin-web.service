[Unit]
Description=Chickin UART web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orangepi
WorkingDirectory=/home/orangepi/webapp-net
ExecStart=/usr/bin/dotnet /home/orangepi/webapp-net/Chickin.Web.dll
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
