{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:80"
      }
    }
  },
  "UART": {
    "PortName": "/dev/ttyS5",
    "BaudRate": 115200,
    "ReadTimeoutMilliseconds": 3000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Chickin.Web.Services.UartService": "Debug"
    }
  },
  "AllowedHosts": "*"
}
